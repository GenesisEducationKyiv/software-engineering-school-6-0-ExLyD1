{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/claude-memory && uv run python hooks/session-end.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/claude-memory && uv run python hooks/session-end.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
