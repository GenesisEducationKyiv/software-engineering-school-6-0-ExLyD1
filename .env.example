# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# PostgreSQL service credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=github_notifier_genesis

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Public base URL of the app, used in email links (no trailing slash)
BASE_URL=http://localhost:3000

# GitHub personal access token (optional — increases rate limit from 60 to 5000 req/h)
# GITHUB_TOKEN=your_github_personal_access_token

# GitHub REST API base URL (change only for testing/mocking)
GITHUB_BASE_URL=https://api.github.com

# "From" address shown in outgoing emails
SMTP_FROM=GitHub Notifier<noreply@ghnotifier.xyz>
RESEND_API_KEY=re_JFbzpJq8_NpKLJjEiYvdzK4wkEG4MdbTk

SCANNER_INTERVAL_MS=300000


